# CallSevai Bot — Environment Variables
# Copy this file to .env and fill in your real values

# Your WhatsApp Business number (include country code, no +, no spaces)
# Format: 91XXXXXXXXXX@c.us
OWNER_NUMBER=918778373517@c.us

# Google Apps Script Web App URL
# Get this after deploying apps-script.gs as a Web App
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID_HERE/exec

# Bot active hours (24-hour format, IST)
BOT_ACTIVE_FROM=8
BOT_ACTIVE_TO=21
